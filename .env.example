# Copy to .env and fill in. NEVER commit a filled .env.

# --- Required ------------------------------------------------------------------
# Bot token from the Developer Portal → Bot → Reset Token.
DISCORD_TOKEN=

# --- Recommended ---------------------------------------------------------------
# Server where moderators work: /mod is registered here (needs Ban Members).
MOD_GUILD_ID=
# Channel in that server where reports are posted with action buttons.
MOD_CHANNEL_ID=
# A PRIVATE channel only the bot can see, used to store profile photos.
# Without it, photos are stored in each user's DM with the bot.
MEDIA_CHANNEL_ID=
# Invite link to a server the bot is in. Bots can only DM people who share a
# server with them, so this link is offered whenever DMs fail.
SUPPORT_SERVER_URL=

# --- Optional ------------------------------------------------------------------
# Taken from the token's application automatically when empty.
DISCORD_APPLICATION_ID=
# Extra moderators (comma-separated user ids). The app owner/team always is one.
ADMIN_USER_IDS=
# Name shown in messages (defaults to the application name).
BRAND_NAME=

# Where data is kept (SQLite, created automatically).
DATABASE_PATH=./data/bot.db

# gateway (default) or http. In http mode set an Interactions Endpoint URL in
# the Developer Portal pointing at http(s)://your-host:HTTP_PORT/HTTP_PATH.
INTERACTIONS_MODE=gateway
DISCORD_PUBLIC_KEY=
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_PATH=/interactions

# global (default), guild (instant updates in DEV_GUILD_ID, for development), off
COMMANDS_SYNC=global
DEV_GUILD_ID=

# Limits
LIKES_PER_DAY=60
REPORTS_PER_DAY=10
MAX_PHOTOS=6
MAX_PHOTO_MB=8
# Refuse Discord accounts younger than this many days (0 = off).
MIN_ACCOUNT_AGE_DAYS=0
CHAT_IDLE_MINUTES=20
CHAT_QUEUE_TIMEOUT_MINUTES=15

# auto, or a fixed number of gateway shards
SHARD_COUNT=auto

# debug | info | warn | error, and pretty | json
LOG_LEVEL=info
LOG_FORMAT=pretty
# Validate every outgoing payload against Discord's documented limits (dev aid).
VALIDATE_PAYLOADS=0
