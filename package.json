{
  "name": "discord-match-bot",
  "version": "2.0.0",
  "description": "A Discord bot for meeting new people: profiles, discovery, mutual matches and anonymous chat. Built directly on the raw Discord API.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "commands": "node --disable-warning=ExperimentalWarning scripts/sync-commands.ts",
    "live-check": "node --disable-warning=ExperimentalWarning scripts/live-check.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "obscenity": "0.4.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
